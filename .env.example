ENABLE_OLLAMA_API=False
WHISPER_MODEL=tiny
TASK_MODEL=ministral-3:3b-cloud
TASK_MODEL_EXTERNAL=ministral-3:3b-cloud
OPENAI_API_BASE_URL=https://ollama.com/v1
OPENAI_API_KEY=OLLAMA_API_KEY
CORS_ALLOW_ORIGIN="http://192.168.1.222:5000;http://localhost:5000;https://refyne.hyprlabs.io"
# Leave WEBUI_SECRET_KEY unset to use the backend's generated persistent key.
# For multiple instances, set the same securely generated random secret on every instance.
RAG_EMBEDDING_ENGINE=
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_BATCH_SIZE=32
CHUNK_MIN_SIZE_TARGET=400
CHUNK_SIZE=1500
CHUNK_OVERLAP=150

ENABLE_WEB_SEARCH=True
WEB_SEARCH_ENGINE=ollama_cloud
OLLAMA_CLOUD_WEB_SEARCH_API_KEY=OLLAMA_API_KEY

# With WEBSOCKET_MANAGER=redis, room channels require PUBLISH, SUBSCRIBE and
# UNSUBSCRIBE/PING permissions plus channel ACLs &socketio and &socketio#*.
# Set false for shared-channel delivery. This must match on every instance;
# changing it requires a full fleet restart, not a rolling restart.
# WEBSOCKET_REDIS_ROOM_CHANNELS=true

# AUTOMATIC1111_BASE_URL="http://localhost:7860"
WEBUI_URL=https://refyne.hyprlabs.io
WEBUI_NAME=Refyne
ENABLE_EVALUATION_ARENA_MODELS=False
USER_PERMISSIONS_CHAT_CONTROLS=False
USER_PERMISSIONS_CHAT_MULTIPLE_MODELS=False
USER_PERMISSIONS_CHAT_TTS=True
ENABLE_IMAGE_GENERATION=False

AUDIO_TTS_ENGINE=
AUDIO_STT_ENGINE=openai
AUDIO_STT_OPENAI_API_BASE_URL=http://speaches:8000/v1
AUDIO_STT_OPENAI_API_KEY=speaches
AUDIO_STT_MODEL=Systran/faster-whisper-base.en

# MFA defaults; saved settings take precedence once persistent config is seeded.
ENABLE_MFA=false
MFA_ALLOW_OAUTH_BYPASS=false
MFA_ALLOW_TRUSTED_HEADER_BYPASS=false

# Set to false to keep memory tools enabled without adding memory context to the system context.
ENABLE_MEMORY_SYSTEM_CONTEXT=true

# Set to true to add compact row/column stats to parsed CSV retrieval context.
ENABLE_RAG_CSV_SUMMARY=false

# Set to true to preserve backing file records, storage blobs, and per-file vectors when files are removed from knowledge bases.
ENABLE_KNOWLEDGE_FILE_RETENTION=false

# Comma-separated chunk metadata keys to expose to the model alongside retrieved content.
RAG_SOURCE_METADATA_KEYS=''

# Master switch for internal Tools/Functions and external OpenAPI/MCP/Open Terminal plugins.
# All plugin switches require a restart; the master overrides all feature switches.
ENABLE_PLUGINS=true
# Set false to disable workspace Tools and their dependency installation.
ENABLE_TOOLS=true
# Set false to disable Functions (filters, pipes, actions, event functions) and their dependencies.
ENABLE_FUNCTIONS=true
# Set false to disable external tools and terminals, including personal direct connections.
ENABLE_TOOL_SERVERS=true

# Terminal metadata requests may start a container. Default: 60 seconds.
# When unset, inherits an explicitly configured AIOHTTP_CLIENT_TIMEOUT_TOOL_SERVER_DATA.
# Empty or 0 disables the timeout. Other tool-server metadata still defaults to 10 seconds.
# AIOHTTP_CLIENT_TIMEOUT_TERMINAL=60

# WARNING: * trusts forwarded headers from every connection. Use only behind a trusted
# proxy that sanitizes these headers and prevents direct access to the backend.
# Otherwise, set this to the IP addresses or networks of your trusted reverse proxies.
FORWARDED_ALLOW_IPS='*'

# DO NOT TRACK
SCARF_NO_ANALYTICS=true
DO_NOT_TRACK=true
ANONYMIZED_TELEMETRY=false

# Valkey Vector Store (requires VECTOR_DB=valkey)
# VALKEY_URL='valkey://localhost:6379'
# VALKEY_COLLECTION_PREFIX='open_webui'
# VALKEY_INDEX_TYPE='HNSW'
# VALKEY_DISTANCE_METRIC='COSINE'
# VALKEY_HNSW_M='16'
# VALKEY_HNSW_EF_CONSTRUCTION='200'
# VALKEY_HNSW_EF_RUNTIME='10'
