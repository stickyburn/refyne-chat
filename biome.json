{
	"$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
	"files": {
		"include": ["src/**", "*.svelte", "*.ts", "*.js", "*.json"],
		"ignore": [
			"backend/**",
			"node_modules/**",
			"build/**",
			"cypress/**",
			"*.config.*",
			"static/**",
			".svelte-kit/**"
		]
	},
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noExplicitAny": "off"
			},
			"style": {
				"useConst": "off",
				"useImportType": "off"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 1,
		"lineEnding": "lf",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "none"
		}
	},
	"css": {
		"parser": {
			"cssModules": true
		}
	},
	"overrides": [
		{
			"include": ["*.svelte"],
			"linter": {
				"rules": {
					"a11y": {
						"useAltText": "off",
						"noAccessKey": "off"
					}
				}
			}
		}
	]
}
